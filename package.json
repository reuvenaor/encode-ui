{
  "name": "encode-ui",
  "version": "0.5.1",
  "type": "module",
  "description": "Component lookup over the encode-ui shadcn registry, as an MCP server. Zero setup; local embeddings, no API keys.",
  "homepage": "https://encode-ui.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/reuvenaor/encode-ui.git"
  },
  "bugs": "https://github.com/reuvenaor/encode-ui/issues",
  "author": "Reuven Naor <info@reuvenaor.com>",
  "license": "MIT",
  "bin": {
    "encode-ui": "dist/mcp.js"
  },
  "files": [
    "dist",
    "agent-index.json",
    "theme-anchors.json",
    "index.db",
    "README.md",
    "LICENSE",
    "NOTICE.md"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "shadcn",
    "registry",
    "react",
    "components",
    "semantic-search"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && cp src/schema.sql dist/schema.sql && cp src/lucide-icons.json dist/lucide-icons.json",
    "vendor:icons": "node scripts/vendor-icons.mjs",
    "build:index": "node --experimental-strip-types src/build.ts",
    "verify": "node --experimental-strip-types src/verify.ts",
    "eval": "node --experimental-strip-types eval/run-eval.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test 'test/**/*.test.ts'",
    "check": "npm run typecheck && npm run test",
    "prepack": "node scripts/check-pack-index.mjs && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.22.0",
    "minisearch": "^7.2.0",
    "zod": "^4.4.3"
  },
  "optionalDependencies": {
    "@huggingface/transformers": "^4.2.0",
    "better-sqlite3": "^13.0.1",
    "sqlite-vec": "^0.1.9"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.10.1",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "sharp": "^0.35.0",
    "adm-zip": "^0.6.0"
  }
}
